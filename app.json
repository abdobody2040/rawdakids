{
  "expo": {
    "name": "Rawdakids - روضة كيدز",
    "slug": "rawdakid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rawdakids",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rawdakids.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يُستخدم الميكروفون فقط لتمكين الطفل من تسجيل تلاوته ومراجعتها محلياً على جهازه دون أي مشاركة خارجية. / Used strictly on-device to let children practice and review their Quran recitation."
      }
    },
    "android": {
      "package": "com.rawdakids.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#0F9D6B",
      "backgroundColor": "#0F9D6B",
      "display": "standalone",
      "orientation": "portrait",
      "dir": "rtl",
      "lang": "ar"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#064E3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يُستخدم الميكروفون فقط لتمكين الطفل من تسجيل تلاوته ومراجعتها محلياً على جهازه دون أي مشاركة خارجية. / Used strictly on-device to let children practice and review their Quran recitation.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0cf00dd7-b095-414e-a469-7d38bab56976"
      }
    },
    "owner": "abdobody2020"
  }
}
